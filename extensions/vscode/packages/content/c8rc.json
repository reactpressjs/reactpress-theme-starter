{
  "all": true,
  "src": ["dist"],
  "include": ["dist/**/*.js"],
  "exclude": [
    "dist/**/*.test.js",
    "dist/test-helpers.js",
    "coverage/**"
  ],
  "reporter": ["text", "text-summary"],
  "check-coverage": true,
  "lines": 100,
  "functions": 100,
  "branches": 100,
  "statements": 100,
  "skip-full": true
}
