{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Dark",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "primary",
					"color": "#ff6b61",
					"name": "Primary"
				},
				{
					"slug": "primary-button",
					"color": "#c62828",
					"name": "Primary Button"
				},
				{
					"slug": "background",
					"color": "#1e2a36",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#1a242f",
					"name": "Surface"
				},
				{
					"slug": "surface-alt",
					"color": "#1a242f",
					"name": "Surface Alt"
				},
				{
					"slug": "foreground",
					"color": "#dddbdb",
					"name": "Foreground"
				},
				{
					"slug": "foreground-muted",
					"color": "#b8c0cc",
					"name": "Foreground Muted"
				},
				{
					"slug": "border",
					"color": "#2f373e",
					"name": "Border"
				},
				{
					"slug": "link",
					"color": "#69b1ff",
					"name": "Link"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				}
			}
		}
	}
}
