{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "primary",
					"color": "#f44336",
					"name": "Primary"
				},
				{
					"slug": "primary-button",
					"color": "#c62828",
					"name": "Primary Button"
				},
				{
					"slug": "background",
					"color": "#e7eaee",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "Surface"
				},
				{
					"slug": "surface-alt",
					"color": "#f3f5f7",
					"name": "Surface Alt"
				},
				{
					"slug": "foreground",
					"color": "#1a1a1a",
					"name": "Foreground"
				},
				{
					"slug": "foreground-muted",
					"color": "#595959",
					"name": "Foreground Muted"
				},
				{
					"slug": "border",
					"color": "#e5e6eb",
					"name": "Border"
				},
				{
					"slug": "link",
					"color": "#4299e1",
					"name": "Link"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\"",
					"name": "System Sans",
					"slug": "system-sans"
				}
			],
			"fontSizes": [
				{
					"fluid": {
						"min": "0.875rem",
						"max": "0.875rem"
					},
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"min": "1rem",
						"max": "1rem"
					},
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					},
					"name": "Large",
					"size": "1.25rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "1.5rem",
						"max": "1.875rem"
					},
					"name": "Extra Large",
					"size": "1.875rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"min": "2rem",
						"max": "2.5rem"
					},
					"name": "2X Large",
					"size": "2.5rem",
					"slug": "xx-large"
				}
			]
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"name": "2X Small",
					"size": "0.5rem",
					"slug": "20"
				},
				{
					"name": "X Small",
					"size": "0.75rem",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "1rem",
					"slug": "40"
				},
				{
					"name": "Medium",
					"size": "1.5rem",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "2rem",
					"slug": "60"
				},
				{
					"name": "X Large",
					"size": "3rem",
					"slug": "70"
				},
				{
					"name": "2X Large",
					"size": "4rem",
					"slug": "80"
				}
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"border": {
			"radius": true
		},
		"custom": {
			"radius": "12px",
			"header-height": "64px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			},
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			},
			"button": {
				"border": {
					"radius": "8px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-button)",
						"text": "#ffffff"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"lineHeight": "1.3"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.35"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--foreground)"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--foreground-muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--foreground)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							}
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--foreground-muted)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--foreground)"
							}
						}
					}
				}
			},
			"core/search": {
				"border": {
					"radius": "9999px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--foreground)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							}
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--primary)",
						"width": "4px"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--foreground-muted)"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--surface-alt)"
				},
				"border": {
					"radius": "8px"
				}
			},
			"core/comment-content": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"spacing": {
					"margin": {
						"top": "0.35rem",
						"bottom": "0.5rem"
					}
				}
			},
			"core/comment-author-name": {
				"typography": {
					"fontSize": "0.95rem",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--foreground)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/comment-date": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--foreground-muted)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/comment-edit-link": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--foreground-muted)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/comment-reply-link": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--foreground-muted)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "sidebar",
			"title": "Sidebar",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-sidebar",
			"title": "Page without Sidebar",
			"postTypes": ["page"]
		}
	]
}
