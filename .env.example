# ReactPress API (SSR — Next.js server requests)
REACTPRESS_API_URL=http://localhost:3002/api

# Browser CSR requests — use same-origin /api proxy (recommended for remote API)
NEXT_PUBLIC_REACTPRESS_API_URL=/api

# Public site URL (SEO / sitemap / Open Graph)
CLIENT_SITE_URL=http://localhost:3001

# Cloudflare deploy (vinext). Keep account-specific values in .env, not in git.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_KV_NAMESPACE_ID=
# CLOUDFLARE_DOMAIN=https://demo.example.com

# Embed ReactPress Admin at /admin/ (local dev: auto-starts static server on :3000)
# REACTPRESS_EMBED_ADMIN=1
# REACTPRESS_ADMIN_STATIC_ORIGIN=http://127.0.0.1:3000
# NEXT_PUBLIC_REACTPRESS_ADMIN_URL=http://localhost:3001/admin
#
# Vercel / serverless: bundle admin static assets into public/admin at build time
# REACTPRESS_BUNDLE_ADMIN=1

# Subpath deployment (optional)
# BASE_PATH=/blog

# ── Mock mode (offline demo / CI / Vercel starter deploy) ───────────────────
# REACTPRESS_MOCK_API=1

# ── Remote API during dev (equivalent to --remote-origin) ───────────────────
# REACTPRESS_DEV_REMOTE_ORIGIN=https://api.yoursite.com
# REACTPRESS_DEV_CLIENT_API_ORIGIN=https://api.yoursite.com

# ── Production (Vercel / self-hosted) ───────────────────────────────────────
# Same nginx gateway (site + API same origin):
# REACTPRESS_API_URL=https://api.yoursite.com/api
# NEXT_PUBLIC_REACTPRESS_API_URL=/api
# CLIENT_SITE_URL=https://www.yoursite.com
#
# Cross-subdomain (e.g. demo.yoursite.com + api.yoursite.com):
# REACTPRESS_API_URL=https://api.yoursite.com/api
# NEXT_PUBLIC_REACTPRESS_API_URL=https://api.yoursite.com/api
# CLIENT_SITE_URL=https://demo.yoursite.com
