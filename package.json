{
  "name": "@fecommunity/reactpress-theme-starter",
  "version": "1.0.0-beta.1",
  "description": "ReactPress 博客主题 Starter：Tailwind CSS + Next.js App Router，对接 toolkit 动态内容",
  "license": "MIT",
  "keywords": [
    "reactpress",
    "nextjs",
    "blog",
    "theme",
    "tailwindcss",
    "headless-cms"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactpressjs/reactpress-theme-starter.git"
  },
  "bugs": {
    "url": "https://github.com/reactpressjs/reactpress-theme-starter/issues"
  },
  "homepage": "https://github.com/reactpressjs/reactpress-theme-starter#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "app",
    "components",
    "lib",
    "public",
    "scripts",
    "theme.json",
    "theme.manifest.schema.json",
    "next.config.cjs",
    "postcss.config.cjs",
    "prettier.config.cjs",
    "vite.config.ts",
    "cloudflare.config.ts",
    "eslint.config.mjs",
    "tsconfig.json",
    "svg.d.ts",
    "vercel.json",
    ".env.example"
  ],
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock": "cross-env REACTPRESS_MOCK_API=1 node scripts/dev.mjs",
    "dev:admin": "node node_modules/@fecommunity/reactpress-web/bin/reactpress-web.js start --port 3000",
    "clean": "rm -rf .next .next-dev",
    "prebuild": "node scripts/copy-admin-dist.mjs",
    "build": "cross-env INIT_CWD=$PWD next build",
    "build:mock": "node scripts/build-mock.mjs",
    "build:ci": "pnpm clean && cross-env INIT_CWD=$PWD next build",
    "start": "cross-env INIT_CWD=$PWD next start -p 3001",
    "start:mock": "node scripts/start-mock.mjs",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint:check && pnpm run format:check",
    "postinstall": "node scripts/verify-toolkit.mjs && node scripts/ensure-env.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "build:vinext:mock": "cross-env REACTPRESS_MOCK_API=1 REACTPRESS_BUNDLE_ADMIN=1 NEXT_PUBLIC_REACTPRESS_API_URL=/api NEXT_PUBLIC_REACTPRESS_ADMIN_URL=/admin CLIENT_SITE_URL=https://demo.reactpress.cc REACTPRESS_API_URL=https://demo.reactpress.cc/api sh -c 'node scripts/copy-admin-dist.mjs && vite build'",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy:vinext:mock": "pnpm run build:vinext:mock && vinext-cloudflare deploy"
  },
  "dependencies": {
    "@fecommunity/reactpress-toolkit": "^3.1.0",
    "@fecommunity/reactpress-web": "^3.7.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@vinext/cloudflare": "^1.3.4",
    "cross-env": "^10.1.0",
    "highlight.js": "^9.18.5",
    "next": "15.5.12",
    "nprogress": "^0.2.0",
    "postcss": "^8.5.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "^4.1.18",
    "viewerjs": "^1.5.0",
    "vinext": "^1.4.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.16",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.18.0",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "1.0.0-beta.30",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "vite": "8.3.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "type": "module"
}
